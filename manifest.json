{
  "manifest_version": 3,
  "name": "Music Library",
  "version": "2.0.0",
  "description": "Your sound, your space. A personal music library with search, playlists, and a focused new-tab player.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "js/background.js", "type": "module" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Music Library",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'"
  }
}
